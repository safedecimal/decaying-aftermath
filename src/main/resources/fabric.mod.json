{
  "schemaVersion": 1,
  "id": "abjection",
  "version": "${version}",
  "name": "Abjection",
  "description": "Abjection for Minecraft 26.3 (Fabric): a medical, physiological, and psychological survival mod featuring body-part injuries, treatment procedures, vitals, mental health, and an afterlife aftermath.",
  "authors": [
    "safedecimal"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.safedecimal.decayingaftermath.DecayingAftermath"
    ],
    "client": [
      "io.github.safedecimal.decayingaftermath.client.DecayingAftermathClient"
    ]
  },
  "mixins": [
    "decaying-aftermath.mixins.json",
    "decaying-aftermath.client.mixins.json",
    "decaying-aftermath.compat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "cruor": "*",
    "ragdollified": "*"
  }
}
